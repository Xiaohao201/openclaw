{
  "id": "rabbitmq-consumer",
  "name": "RabbitMQ Consumer",
  "description": "Consume chat messages from RabbitMQ, process them via OpenClaw subagent, and push responses via Mercure.",
  "contracts": {
    "tools": ["video_link_parse"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "rabbitmq": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "host": { "type": "string" },
          "port": { "type": "number" },
          "user": { "type": "string" },
          "password": { "type": "string" },
          "queue": { "type": "string" },
          "reportTaskQueue": { "type": "string", "default": "ReportTask" },
          "prefetch": { "type": "number", "default": 6 }
        },
        "required": ["host", "user", "password"]
      },
      "historyDb": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "host": { "type": "string" },
          "port": { "type": "number" },
          "user": { "type": "string" },
          "password": { "type": "string" },
          "database": { "type": "string" }
        },
        "required": ["host", "user", "password", "database"]
      },
      "writerDb": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "host": { "type": "string" },
          "port": { "type": "number" },
          "user": { "type": "string" },
          "password": { "type": "string" },
          "database": { "type": "string" }
        },
        "required": ["host", "user", "password", "database"]
      },
      "mercure": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "hubUrl": { "type": "string" },
          "jwtSecret": { "type": "string" }
        },
        "required": ["hubUrl", "jwtSecret"]
      },
      "chat": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "turnTimeoutSeconds": {
            "type": "number",
            "default": 300,
            "minimum": 60,
            "maximum": 3600,
            "description": "Gateway wait polling window. When it elapses, the consumer keeps waiting; it does not cancel or fail the embedded run."
          }
        }
      },
      "localDebug": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false,
            "description": "Enable a loopback-only local RabbitMQ message simulator. It records events locally, reuses configured data connections, and writes chat history only to the isolated historyTable."
          },
          "historyTable": {
            "type": "string",
            "default": "history_test",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
            "description": "MySQL table used only for local debug chat history. It is created from history_messages when missing."
          }
        },
        "required": ["enabled"]
      },
      "oss": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accessKeyId": { "type": "string" },
          "accessKeySecret": { "type": "string" },
          "bucket": { "type": "string", "default": "leadingnews" },
          "endpoint": { "type": "string", "default": "oss-cn-beijing.aliyuncs.com" },
          "customDomain": { "type": "string", "default": "https://oss.ibtai.com" },
          "pathPrefix": { "type": "string", "default": "ibtai/assistant-agent/outputs" },
          "maxFileSizeMb": { "type": "number", "default": 100 },
          "allowedExtensions": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["accessKeyId", "accessKeySecret"]
      }
    },
    "anyOf": [
      { "required": ["rabbitmq", "historyDb", "mercure"] },
      {
        "required": ["localDebug"],
        "properties": {
          "localDebug": {
            "type": "object",
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          }
        }
      }
    ]
  }
}
